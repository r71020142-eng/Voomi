    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="Content-Language" content="pt-BR" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Google Analytics (GA4) — loaded only on production so dev/localhost don't pollute the data -->
    <script>
      if (location.hostname === "voomi.app.br") {
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());
        gtag("config", "G-MD363QMB2M");
        // Deferred to `load`: gtag.js is ~168 KB compressed and used to contend with the
        // render-blocking CSS for a mobile link's bandwidth. Hits queue in dataLayer until
        // it arrives, so nothing is lost.
        addEventListener("load", function () {
          var gaScript = document.createElement("script");
          gaScript.async = true;
          gaScript.src = "https://www.googletagmanager.com/gtag/js?id=G-MD363QMB2M";
          document.head.appendChild(gaScript);
        });
      }
    </script>

    <!-- Do not offer machine translation: the UI is intentionally Brazilian Portuguese -->
    <meta name="google" content="notranslate" />

    <!-- Performance: warm up the Supabase origin the app calls on first paint. This is the
         custom domain the client tries FIRST (see src/integrations/supabase/client.ts); the
         *.supabase.co host is only the failover, so it gets dns-prefetch, not a handshake. -->
    <link rel="preconnect" href="https://api.tikshoplab.com.br" crossorigin />
    <link rel="dns-prefetch" href="https://jdeucaxtmgkzeqihayki.supabase.co" />

    <!-- Icons & PWA -->
